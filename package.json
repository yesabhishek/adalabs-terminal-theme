{
  "name": "adalabs-terminal",
  "displayName": "AdaLabs Terminal",
  "publisher": "AbhishekChoudhury",
  "description": "Twenty hand-tuned VS Code themes — 10 dark (Obsidian to Dusk) and 10 light (Snow to Stone) — where the editor, sidebar, terminal, syntax and icons all share one palette.",
  "version": "2.0.0",
  "icon": "assets/icon.png",
  "license": "MIT",
  "author": {
    "name": "Abhishek Choudhury",
    "url": "https://www.abhishekchoudhury.com"
  },
  "homepage": "https://www.abhishekchoudhury.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/yesabhishek/adalabs-terminal-theme"
  },
  "bugs": {
    "url": "https://github.com/yesabhishek/adalabs-terminal-theme/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "dark theme",
    "light theme",
    "oled",
    "black",
    "slate",
    "paper",
    "sepia",
    "terminal",
    "syntax",
    "low contrast",
    "adalabs"
  ],
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "package": "node scripts/build.mjs && vsce package --no-dependencies",
    "shots": "node scripts/preview.mjs && node scripts/screenshots.mjs"
  },
  "contributes": {
    "themes": [
      {
        "label": "AdaLabs Obsidian",
        "uiTheme": "vs-dark",
        "path": "./themes/obsidian.json"
      },
